# ─────────────────────────────────────────────────────────────
# KI-Readiness-Check · Umgebungsvariablen
# Kopiere diese Datei zu `.env.local` und trage deine Werte ein.
# (.env.local wird NICHT eingecheckt.)
# ─────────────────────────────────────────────────────────────

# ── Brevo (Lead-Erfassung + Follow-up-Sequenzen) ──────────────
# API-Key: Brevo → SMTP & API → API-Keys (v3-Key, beginnt mit "xkeysib-")
BREVO_API_KEY=

# ID der Brevo-Kontaktliste, in die Leads einsortiert werden.
# Diese Liste triggert deine Follow-up-Automation in Brevo.
BREVO_LIST_ID=

# Optional: Double-Opt-In (DSGVO). Wenn beide gesetzt sind, verschickt Brevo
# eine Bestätigungsmail statt den Kontakt direkt zu bestätigen.
# Template-ID einer DOI-Vorlage in Brevo (Transaktions-E-Mail).
BREVO_DOI_TEMPLATE_ID=
# Seite, auf die nach Bestätigung weitergeleitet wird.
BREVO_DOI_REDIRECT_URL=

# ── CRM-Weiterleitung (später · D:\dev\crm-clean) ─────────────
# Sobald gesetzt, wird jeder Lead zusätzlich als JSON an diese URL geschickt.
# Leer lassen, solange nur Brevo genutzt wird.
CRM_WEBHOOK_URL=
# Optionales Shared Secret → wird als "Authorization: Bearer <secret>" gesendet.
CRM_WEBHOOK_SECRET=

# ── Calendly (CTA / Terminbuchung) ───────────────────────────
# Persona-abhängige Buchungslinks. Solo → Erstgespräch, KMU/Bereich → Check.
# Wenn nur eine URL gesetzt ist, wird sie für alle Personas genutzt.
NEXT_PUBLIC_CALENDLY_URL_SOLO=
NEXT_PUBLIC_CALENDLY_URL_BUSINESS=

# ── Rechtliches / Links ──────────────────────────────────────
NEXT_PUBLIC_PRIVACY_URL=https://zweimeter.consulting/datenschutz
NEXT_PUBLIC_SITE_URL=https://ki-check.zweimeter.consulting

# ── Analytics (optional, DSGVO-freundlich) ───────────────────
# Plausible: cookiefrei, ohne Consent-Banner nutzbar. Domain wie in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 (optional) – Measurement-ID, z.B. G-XXXXXXX
NEXT_PUBLIC_GA_ID=
