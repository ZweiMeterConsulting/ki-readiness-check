# ── E-Mail-Versand (Pflicht) ─────────────────────────────
# API-Key aus https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Absender. Die Domain muss bei Resend verifiziert sein (SPF/DKIM-DNS-Einträge).
MAIL_FROM="KI-Readiness-Check <check@zweimeter.consulting>"

# Interne Lead-Benachrichtigung (bekommt jede Auswertung inkl. PDF und allen Antworten)
LEAD_NOTIFY_EMAIL=robert@zweimeter.online

# Antwortadresse für die Kunden-Mail (optional, Standard = LEAD_NOTIFY_EMAIL)
MAIL_REPLY_TO=robert@zweimeter.online

# ── Brevo-Kontaktsync (Marketing-Sales-Bridge) ───────────
# API-Key aus https://app.brevo.com/settings/keys/api
# Fehlt der Key, wird der Sync übersprungen (Report-Versand läuft trotzdem).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# ID der Kontaktliste "KI-Readiness-Leads" (optional; siehe scripts im Tag juli-2026-brevo-puppeteer)
BREVO_LIST_ID=

# ── Links im Frontend (optional) ─────────────────────────
NEXT_PUBLIC_PRIVACY_URL=https://zweimeter.consulting/datenschutz
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/zweimeterconsulting/kennenlerngesprach-ki-strategie-30-minuten
# CTA-Ziel für Einzelunternehmer (Standard = Calendly-Link)
NEXT_PUBLIC_CTA_URL_SOLO=https://calendly.com/zweimeterconsulting/kennenlerngesprach-ki-strategie-30-minuten
NEXT_PUBLIC_CTA_URL_BUSINESS=https://zweimeter.consulting
NEXT_PUBLIC_CONTACT_EMAIL=robert@zweimeter.online

# ── Entwicklung ──────────────────────────────────────────
# Auf 1 setzen, um unter /api/report?preview=1 ein Demo-PDF ohne Versand zu sehen. In Produktion NICHT setzen.
REPORT_PREVIEW=0
